# Required: main upstream data service.
MINECRAFT_SERVER_URL=http://your-upstream.example

# Required: Minecraft status fallback used when /api/players upstream is unavailable.
MINECRAFT_SERVER_ADDRESS=play.example.com
MINECRAFT_SERVER_PORT=25565

# Required: Cloudflare Access application settings for /admin*.
CLOUDFLARE_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=your-access-application-aud

# Required: shared server-side secret accepted from MikWeb auth BFF requests.
MIKWEB_AUTH_CLIENT_SECRET=replace-with-the-same-server-secret-as-mikweb

# Optional: Afdian open API credentials for the public sponsor catalog.
# Leave unset to serve sponsors from manual records only.
AFDIAN_USER_ID=
AFDIAN_API_TOKEN=

# Optional: WebAuthn Passkey relying party settings. Defaults to production.
# For local MikWeb development, use WEBAUTHN_RP_ID=localhost and WEBAUTHN_ORIGIN=http://localhost:3000.
WEBAUTHN_RP_ID=mcmik.top
WEBAUTHN_ORIGIN=https://mcmik.top

# HTTPS URL including the bucket name. The public base defaults to this URL.
BUILDING_IMAGE_S3_BUCKET_URL=
BUILDING_IMAGE_S3_REGION=
BUILDING_IMAGE_PUBLIC_BASE_URL=
BUILDING_IMAGE_ACCESS_KEY_ID=
BUILDING_IMAGE_SECRET_ACCESS_KEY=
