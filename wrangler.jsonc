{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mikdata",
	"account_id": "936caa3c87b953e8865de39834abccbf",
	"main": "src/index.ts",
	"build": { "command": "bun scripts/prepare-admin-images.ts" },
	"assets": { "directory": "./dist/admin-assets" },
	"compatibility_date": "2026-11-25",
	"compatibility_flags": ["no_nodejs_compat"],
	"workers_dev": false,
	"keep_vars": true,
	"routes": [
		{
			"pattern": "data.mcmik.top",
			"custom_domain": true
		}
	],
	"placement": {
		"mode": "smart"
	},
	"observability": {
		"enabled": true
	},
	"ratelimits": [
		{
			"name": "AUTH_CLIENT_RATE_LIMITER",
			"namespace_id": "81126002",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "AUTH_SESSION_CHECK_IP_RATE_LIMITER",
			"namespace_id": "81126006",
			"simple": {
				"limit": 300,
				"period": 60
			}
		},
		{
			"name": "AUTH_CHALLENGE_CREATE_RATE_LIMITER",
			"namespace_id": "81126003",
			"simple": {
				"limit": 8,
				"period": 60
			}
		},
		{
			"name": "AUTH_SENSITIVE_RATE_LIMITER",
			"namespace_id": "81126004",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_API_RATE_LIMITER",
			"namespace_id": "81126005",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mikdata",
			"database_id": "e5c5baa7-a900-4e62-b91f-dc6a788f4012"
		}
	],
	"vpc_services": [
		{
			"binding": "VPC_SERVICE",
			"service_id": "019f0423-6121-7610-a9b7-4253dd29cfe2",
			"remote": true
		}
	]
}
